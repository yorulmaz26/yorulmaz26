<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KuaforumCepte" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kc_offwhite</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ SplashScreen API (core-splashscreen ile geriye uyumlu) -->
    <style name="Theme.KuaforumCepte.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kc_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.KuaforumCepte</item>
    </style>
</resources>
