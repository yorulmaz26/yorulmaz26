# Google Play yayın imzası için bu dosyayı keystore.properties olarak kopyalayın (depoya EKLEMEYİN).
# Anahtar üretmek için: keytool -genkeypair -v -keystore yeralti-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias yeralti
storeFile=yeralti-release.jks
storePassword=degistirin
keyAlias=yeralti
keyPassword=degistirin
