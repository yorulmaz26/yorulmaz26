rules_version = '2';

// Kuş Dili — Firestore güvenlik kuralları.
// Testler: firebase/rules-test (Emulator Suite). Kural değişikliği = test.
service cloud.firestore {
  match /databases/{database}/documents {

    // Yalnızca telefon numarasıyla doğrulanmış hesaplar.
    function verified() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'phone';
    }

    function isSelf(uid) {
      return verified() && request.auth.uid == uid;
    }

    // lib/features/profile/domain/username.dart ile AYNI olmalı.
    function validUsername(n) {
      return n is string
        && n.matches('^[a-z][a-z0-9_.]{2,19}$')
        && !n.matches('.*[.][.].*')
        && !n.matches('.*[.]$')
        && !(n in ['admin', 'administrator', 'root', 'system', 'support',
                   'destek', 'kusdili', 'kus_dili', 'kus.dili', 'moderator',
                   'yonetici', 'official', 'resmi', 'help', 'yardim', 'null',
                   'undefined']);
    }

    function validGroupName(n) {
      return n is string && n.size() >= 1 && n.size() <= 50;
    }

    function validDisplayName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    // Herkese açık profil. Telefon numarası burada tutulmaz.
    match /users/{uid} {
      allow read: if verified();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['username', 'displayName', 'createdAt'])
        && validUsername(request.resource.data.username)
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time
        // Aynı işlemde kullanıcı adı bu kullanıcıya ayrılmış olmalı.
        && getAfter(usernamePath(request.resource.data.username)).data.uid == uid;

      // Kullanıcı adı ve oluşturulma zamanı değiştirilemez.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validDisplayName(request.resource.data.displayName);

      allow delete: if false;
    }

    // Kullanıcı adı benzersizlik kilidi: usernames/{ad} → { uid }.
    match /usernames/{name} {
      allow read: if verified();

      allow create: if verified()
        && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        // Profil henüz yok (tek ad) ve aynı işlemde bu adla oluşturuluyor.
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.username == name;

      allow update, delete: if false;
    }

    // Sohbet ayarları: yalnızca sahibi (karşı taraf göremez).
    match /users/{uid}/chatSettings/{chatId} {
      allow read, delete: if isSelf(uid);
      allow write: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['sendMode', 'variant', 'viewMode', 'disappear'])
        && (!('disappear' in request.resource.data)
            || request.resource.data.disappear in [0, 30, 300, 3600, 86400, 604800])
        && request.resource.data.sendMode in ['p', 'k']
        && request.resource.data.viewMode in ['asSent', 'original', 'both']
        && request.resource.data.variant is map
        && request.resource.data.variant.size() <= 4;
    }

    // ---------------------------------------------------------- Engelleme
    // blocks/{uid}: { uids: [...], updatedAt }. Yalnızca sahibi okur/yazar;
    // engellenen kişi listeyi göremez. Kurallar get() ile okur.
    function blockPath(uid) {
      return /databases/$(database)/documents/blocks/$(uid);
    }

    // [a], [b]'yi engellemiş mi?
    function hasBlocked(a, b) {
      return exists(blockPath(a)) && b in get(blockPath(a)).data.uids;
    }

    // İki kişilik sohbette taraflardan biri diğerini engellemiş mi?
    function directBlocked(chatId) {
      return chatId.matches('^d_.*')
        && (hasBlocked(chatId.split('_')[1], chatId.split('_')[2])
            || hasBlocked(chatId.split('_')[2], chatId.split('_')[1]));
    }

    match /blocks/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uids', 'updatedAt'])
        && request.resource.data.uids is list
        && request.resource.data.uids.size() <= 1000
        && !(uid in request.resource.data.uids)
        && request.resource.data.updatedAt == request.time;
    }

    // ------------------------------------------------------------ Şikâyet
    // Uygulamadan kimse okuyamaz; moderasyon Firebase konsolundan yapılır.
    // Mesaj metinleri yalnızca şikâyet edenin onayıyla, onun cihazında
    // çözülüp eklenir (en fazla 5).
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['reporter', 'reported',
             'chatId', 'reason', 'note', 'messages', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.chatId is string
        && isMember(request.resource.data.chatId)
        && (!('reported' in request.resource.data)
            || (request.resource.data.reported is string
                && request.resource.data.reported != request.auth.uid
                && request.resource.data.reported
                     in chatData(request.resource.data.chatId).members))
        && request.resource.data.reason in
             ['spam', 'harassment', 'inappropriate', 'impersonation', 'other']
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 500))
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 5
        && request.resource.data.createdAt == request.time;
    }

    // ---------------------------------------------------------------- Sohbet
    // chats/{chatId}: iki kişilik sohbet, kimlik 'd_<küçük uid>_<büyük uid>'.
    // Önizleme metni TUTULMAZ.
    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isMember(chatId) {
      return verified() && request.auth.uid in chatData(chatId).members;
    }

    match /chats/{chatId} {
      // Var olmayan kendi sohbet kimliğini okumaya izin ver (oluşturmadan
      // önce varlık kontrolü); başkalarının sohbetinin varlığı sızmaz.
      allow get: if verified() && (
        (resource == null && request.auth.uid in chatId.split('_'))
        || (resource != null && request.auth.uid in resource.data.members));

      // Liste sorgusu: where('members', arrayContains: uid).
      allow list: if verified() && request.auth.uid in resource.data.members;

      allow create: if verified()
        && request.resource.data.keys().hasOnly(
             ['type', 'members', 'createdAt', 'lastActivityAt', 'readAt'])
        && request.resource.data.type == 'direct'
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == 'd_' + request.resource.data.members[0]
                     + '_' + request.resource.data.members[1]
        && exists(userPath(request.resource.data.members[0]))
        && exists(userPath(request.resource.data.members[1]))
        && !directBlocked(chatId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivityAt == request.time
        && request.resource.data.readAt == {};

      // Üyeler yalnızca: son etkinlik (kendi gönderdiği mesajla) ve kendi
      // okuma zamanını değiştirebilir.
      allow update: if verified()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastActivityAt', 'lastSenderId', 'readAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['lastActivityAt', 'lastSenderId'])
            || (request.resource.data.lastActivityAt == request.time
                && request.resource.data.lastSenderId == request.auth.uid
                && !directBlocked(chatId)))
        && request.resource.data.readAt.diff(resource.data.readAt)
             .affectedKeys().hasOnly([request.auth.uid])
        && (!request.resource.data.readAt.diff(resource.data.readAt)
              .affectedKeys().hasAny([request.auth.uid])
            || request.resource.data.readAt[request.auth.uid] == request.time);

      // ---- Grup ----
      allow create: if verified()
        && chatId.matches('^g_[A-Za-z0-9]{10,40}$')
        && request.resource.data.keys().hasOnly(['type', 'name', 'members',
             'admins', 'createdBy', 'createdAt', 'lastActivityAt', 'readAt'])
        && request.resource.data.type == 'group'
        && validGroupName(request.resource.data.name)
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 64
        && request.auth.uid in request.resource.data.members
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivityAt == request.time
        && request.resource.data.readAt == {};

      // Yönetici: ad, üyeler ve yöneticiler.
      allow update: if verified()
        && resource.data.type == 'group'
        && request.auth.uid in resource.data.admins
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'members', 'admins'])
        && validGroupName(request.resource.data.name)
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 1
        && request.resource.data.members.size() <= 64
        && request.resource.data.admins.size() >= 1
        && request.resource.data.members.hasAll(request.resource.data.admins);

      // Herhangi bir üye ayrılabilir; son yöneticiyse yerine bir üye geçer.
      allow update: if verified()
        && resource.data.type == 'group'
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'admins'])
        && request.resource.data.members
             == resource.data.members.removeAll([request.auth.uid])
        && !(request.auth.uid in request.resource.data.admins)
        && request.resource.data.members.hasAll(request.resource.data.admins)
        && (request.resource.data.admins
              == resource.data.admins.removeAll([request.auth.uid])
            || resource.data.admins.removeAll([request.auth.uid]).size() == 0)
        && (request.resource.data.admins.size() >= 1
            || request.resource.data.members.size() == 0);

      allow delete: if false;

      // Grup gönderici anahtarı paylaşımları: her üye için birebir şifreli.
      // Değiştirilemez; kimlik 'gönderen_dönem'.
      match /senderKeys/{keyId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.keys().hasOnly(
               ['sender', 'epoch', 'shares', 'createdAt'])
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.epoch is int
          && keyId == request.auth.uid + '_' + string(request.resource.data.epoch)
          && request.resource.data.shares is map
          && request.resource.data.shares.size() <= 64
          && request.resource.data.shares.keys().hasOnly(chatData(chatId).members)
          && !(request.auth.uid in request.resource.data.shares)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // Mesajlar: gövde mühürlüdür (Aşama 7'den itibaren şifreli).
      match /messages/{messageId} {
        allow read: if isMember(chatId);

        allow create: if isMember(chatId)
          && request.resource.data.keys().hasOnly(
               ['senderId', 'sentAt', 'encVersion', 'body', 'deleted',
                'expireAt', 'viewOnce'])
          // Süreli mesaj: en geç 8 gün sonra silinir (sunucu TTL'i).
          && (!('expireAt' in request.resource.data)
              || (request.resource.data.expireAt is timestamp
                  && request.resource.data.expireAt > request.time
                  && request.resource.data.expireAt
                       <= request.time + duration.value(8, 'd')))
          && (!('viewOnce' in request.resource.data)
              || request.resource.data.viewOnce == true)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.sentAt == request.time
          // Engellenen / engelleyen birebir mesaj gönderemez.
          && !directBlocked(chatId)
          // Yalnızca uçtan uca şifreli (Signal) gövde kabul edilir.
          && request.resource.data.encVersion == 1
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 65536
          && request.resource.data.deleted == false;

        // Alıcı tek görüntülük mesajı açınca içeriği kaldırır.
        allow update: if isMember(chatId)
          && resource.data.get('viewOnce', false) == true
          && resource.data.senderId != request.auth.uid
          && resource.data.deleted == false
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deleted', 'body'])
          && request.resource.data.deleted == true
          && request.resource.data.body == '';

        // Gönderen düzenleyebilir veya herkesten silebilir (tek görüntülük
        // mesaj düzenlenemez).
        allow update: if isMember(chatId)
          && resource.data.senderId == request.auth.uid
          && resource.data.deleted == false
          && (
            (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deleted', 'body'])
             && request.resource.data.deleted == true
             && request.resource.data.body == '')
            ||
            (resource.data.get('viewOnce', false) == false
             && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['body', 'editedAt'])
             && request.resource.data.editedAt == request.time
             && request.resource.data.body is string
             && request.resource.data.body.size() > 0
             && request.resource.data.body.size() <= 65536)
          );

        allow delete: if false;
      }
    }

    // ------------------------------------------------- Bildirim belirteçleri
    // Yalnızca sahibi (ve yönetici yetkili Cloud Function) okur/yazar.
    match /pushTokens/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['tokens', 'enabled', 'muted', 'updatedAt'])
        && (!('tokens' in request.resource.data)
            || (request.resource.data.tokens is list
                && request.resource.data.tokens.size() <= 10))
        && (!('enabled' in request.resource.data)
            || request.resource.data.enabled is bool)
        && (!('muted' in request.resource.data)
            || (request.resource.data.muted is list
                && request.resource.data.muted.size() <= 500))
        && request.resource.data.updatedAt == request.time;
    }

    // ------------------------------------------------- Açık anahtar dizini
    // Yalnızca AÇIK anahtarlar. Özel anahtarlar cihazdan çıkmaz.
    match /keyBundles/{uid} {
      allow read: if verified();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['registrationId', 'identityKey',
             'signedPreKeyId', 'signedPreKey', 'signedPreKeySignature', 'updatedAt'])
        && request.resource.data.keys().hasAll(['registrationId', 'identityKey',
             'signedPreKeyId', 'signedPreKey', 'signedPreKeySignature', 'updatedAt'])
        && request.resource.data.registrationId is int
        && request.resource.data.signedPreKeyId is int
        && request.resource.data.identityKey is string
        && request.resource.data.identityKey.size() <= 64
        && request.resource.data.signedPreKey is string
        && request.resource.data.signedPreKey.size() <= 64
        && request.resource.data.signedPreKeySignature is string
        && request.resource.data.signedPreKeySignature.size() <= 128
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Tek kullanımlık ön-anahtarlar: sahibi ekler; oturum kurmak isteyen
      // herhangi bir doğrulanmış kullanıcı bir tanesini tüketir (siler).
      match /prekeys/{keyId} {
        allow read: if verified();
        allow create: if isSelf(uid)
          && keyId.matches('^[0-9]{1,8}$')
          && request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key is string
          && request.resource.data.key.size() <= 64;
        allow delete: if verified();
        allow update: if false;
      }
    }

    // Tanımlanmayan her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
