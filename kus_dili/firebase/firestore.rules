rules_version = '2';

// Kuş Dili — Firestore güvenlik kuralları.
// Testler: firebase/rules-test (Emulator Suite). Kural değişikliği = test.
service cloud.firestore {
  match /databases/{database}/documents {

    // Yalnızca telefon numarasıyla doğrulanmış hesaplar.
    function verified() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'phone';
    }

    function isSelf(uid) {
      return verified() && request.auth.uid == uid;
    }

    // lib/features/profile/domain/username.dart ile AYNI olmalı.
    function validUsername(n) {
      return n is string
        && n.matches('^[a-z][a-z0-9_.]{2,19}$')
        && !n.matches('.*[.][.].*')
        && !n.matches('.*[.]$')
        && !(n in ['admin', 'administrator', 'root', 'system', 'support',
                   'destek', 'kusdili', 'kus_dili', 'kus.dili', 'moderator',
                   'yonetici', 'official', 'resmi', 'help', 'yardim', 'null',
                   'undefined']);
    }

    function validDisplayName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    // Herkese açık profil. Telefon numarası burada tutulmaz.
    match /users/{uid} {
      allow read: if verified();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['username', 'displayName', 'createdAt'])
        && validUsername(request.resource.data.username)
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time
        // Aynı işlemde kullanıcı adı bu kullanıcıya ayrılmış olmalı.
        && getAfter(usernamePath(request.resource.data.username)).data.uid == uid;

      // Kullanıcı adı ve oluşturulma zamanı değiştirilemez.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validDisplayName(request.resource.data.displayName);

      allow delete: if false;
    }

    // Kullanıcı adı benzersizlik kilidi: usernames/{ad} → { uid }.
    match /usernames/{name} {
      allow read: if verified();

      allow create: if verified()
        && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        // Profil henüz yok (tek ad) ve aynı işlemde bu adla oluşturuluyor.
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.username == name;

      allow update, delete: if false;
    }

    // Sohbet ayarları: yalnızca sahibi (karşı taraf göremez).
    match /users/{uid}/chatSettings/{chatId} {
      allow read, delete: if isSelf(uid);
      allow write: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['sendMode', 'variant', 'viewMode'])
        && request.resource.data.sendMode in ['p', 'k']
        && request.resource.data.viewMode in ['asSent', 'original', 'both']
        && request.resource.data.variant is map
        && request.resource.data.variant.size() <= 4;
    }

    // ---------------------------------------------------------------- Sohbet
    // chats/{chatId}: iki kişilik sohbet, kimlik 'd_<küçük uid>_<büyük uid>'.
    // Önizleme metni TUTULMAZ.
    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isMember(chatId) {
      return verified() && request.auth.uid in chatData(chatId).members;
    }

    match /chats/{chatId} {
      // Var olmayan kendi sohbet kimliğini okumaya izin ver (oluşturmadan
      // önce varlık kontrolü); başkalarının sohbetinin varlığı sızmaz.
      allow get: if verified() && (
        (resource == null && request.auth.uid in chatId.split('_'))
        || (resource != null && request.auth.uid in resource.data.members));

      // Liste sorgusu: where('members', arrayContains: uid).
      allow list: if verified() && request.auth.uid in resource.data.members;

      allow create: if verified()
        && request.resource.data.keys().hasOnly(
             ['type', 'members', 'createdAt', 'lastActivityAt', 'readAt'])
        && request.resource.data.type == 'direct'
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == 'd_' + request.resource.data.members[0]
                     + '_' + request.resource.data.members[1]
        && exists(userPath(request.resource.data.members[0]))
        && exists(userPath(request.resource.data.members[1]))
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivityAt == request.time
        && request.resource.data.readAt == {};

      // Üyeler yalnızca: son etkinlik (kendi gönderdiği mesajla) ve kendi
      // okuma zamanını değiştirebilir.
      allow update: if verified()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastActivityAt', 'lastSenderId', 'readAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['lastActivityAt', 'lastSenderId'])
            || (request.resource.data.lastActivityAt == request.time
                && request.resource.data.lastSenderId == request.auth.uid))
        && request.resource.data.readAt.diff(resource.data.readAt)
             .affectedKeys().hasOnly([request.auth.uid])
        && (!request.resource.data.readAt.diff(resource.data.readAt)
              .affectedKeys().hasAny([request.auth.uid])
            || request.resource.data.readAt[request.auth.uid] == request.time);

      allow delete: if false;

      // Mesajlar: gövde mühürlüdür (Aşama 7'den itibaren şifreli).
      match /messages/{messageId} {
        allow read: if isMember(chatId);

        allow create: if isMember(chatId)
          && request.resource.data.keys().hasOnly(
               ['senderId', 'sentAt', 'encVersion', 'body', 'deleted'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.sentAt == request.time
          // 0 = geliştirme (şifresiz). Yayından önce yalnızca 1 kabul edilecek.
          && request.resource.data.encVersion in [0, 1]
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 65536
          && request.resource.data.deleted == false;

        // Gönderen düzenleyebilir veya herkesten silebilir.
        allow update: if isMember(chatId)
          && resource.data.senderId == request.auth.uid
          && resource.data.deleted == false
          && (
            (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deleted', 'body'])
             && request.resource.data.deleted == true
             && request.resource.data.body == '')
            ||
            (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['body', 'editedAt'])
             && request.resource.data.editedAt == request.time
             && request.resource.data.body is string
             && request.resource.data.body.size() > 0
             && request.resource.data.body.size() <= 65536)
          );

        allow delete: if false;
      }
    }

    // Tanımlanmayan her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
