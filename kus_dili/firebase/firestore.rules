rules_version = '2';

// Kuş Dili — Firestore güvenlik kuralları.
// Testler: firebase/rules-test (Emulator Suite). Kural değişikliği = test.
service cloud.firestore {
  match /databases/{database}/documents {

    // Yalnızca telefon numarasıyla doğrulanmış hesaplar.
    function verified() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'phone';
    }

    function isSelf(uid) {
      return verified() && request.auth.uid == uid;
    }

    // lib/features/profile/domain/username.dart ile AYNI olmalı.
    function validUsername(n) {
      return n is string
        && n.matches('^[a-z][a-z0-9_.]{2,19}$')
        && !n.matches('.*[.][.].*')
        && !n.matches('.*[.]$')
        && !(n in ['admin', 'administrator', 'root', 'system', 'support',
                   'destek', 'kusdili', 'kus_dili', 'kus.dili', 'moderator',
                   'yonetici', 'official', 'resmi', 'help', 'yardim', 'null',
                   'undefined']);
    }

    function validDisplayName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    // Herkese açık profil. Telefon numarası burada tutulmaz.
    match /users/{uid} {
      allow read: if verified();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['username', 'displayName', 'createdAt'])
        && validUsername(request.resource.data.username)
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time
        // Aynı işlemde kullanıcı adı bu kullanıcıya ayrılmış olmalı.
        && getAfter(usernamePath(request.resource.data.username)).data.uid == uid;

      // Kullanıcı adı ve oluşturulma zamanı değiştirilemez.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validDisplayName(request.resource.data.displayName);

      allow delete: if false;
    }

    // Kullanıcı adı benzersizlik kilidi: usernames/{ad} → { uid }.
    match /usernames/{name} {
      allow read: if verified();

      allow create: if verified()
        && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        // Profil henüz yok (tek ad) ve aynı işlemde bu adla oluşturuluyor.
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.username == name;

      allow update, delete: if false;
    }

    // Tanımlanmayan her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
