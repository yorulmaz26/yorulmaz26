<?xml version="1.0" encoding="utf-8"?>
<!-- Şifreleme anahtarları ve şifreli önbellek bulut yedeğine / cihaz
     aktarımına GİRMEZ: anahtarlar Keystore'a bağlıdır ve başka cihazda
     zaten çözülemez; ayrıca yedekte durmaları gereksiz risk olur. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
