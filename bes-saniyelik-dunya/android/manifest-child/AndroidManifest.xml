<?xml version="1.0" encoding="utf-8"?>
<!-- Yalnızca ads.properties içinde audience=child iken birleştirilir: reklam kitaplığının eklediği reklam kimliği ve
     ilgi alanı (Topics) izinlerini paketten çıkarır. Çocukları kapsayan kitlede yaş ekranı olmadığı için her oyuncu
     "yaşı bilinmeyen" sayılır; reklam kimliği iletilmemeli, ilgi alanına dayalı reklam kullanılmamalıdır. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
</manifest>
